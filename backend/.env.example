# Retailza Backend Environment Configuration Template

# Database:
# Local SQLite fallback:
DATABASE_URL=sqlite:///./retailza.db

# MySQL Database (Local or Cloud - AWS RDS, PlanetScale, Aiven, GCP Cloud SQL):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/retailza_db?charset=utf8mb4

# Aiven PostgreSQL Cloud Database:
# DATABASE_URL=postgresql://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require

# Security & JWT
SECRET_KEY=retailza_change_this_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP Configuration
OTP_EXPIRE_MINUTES=5
DEBUG_MOCK_OTP=True
MOCK_OTP_CODE=123456

# Subscription Payments (self-hosted UPI Gateway)
# Create a merchant in the gateway dashboard and copy its API key/secret and
# Live webhook signing secret. Point the gateway webhook URL to:
#   https://<retailza-api-host>/api/subscriptions/gateway-webhook
UPI_GATEWAY_BASE_URL=https://pay.example.com
UPI_GATEWAY_API_KEY=
UPI_GATEWAY_API_SECRET=
UPI_GATEWAY_WEBHOOK_SECRET=
# true only when testing with Sandbox keys (test_key_...); never in production
UPI_GATEWAY_ALLOW_SANDBOX=false
SUBSCRIPTION_AMOUNT=49.00

# App Settings
APP_NAME=Retailza
APP_ENV=development
DEBUG=True

# Retailza Backend Environment Configuration Template

# Database:
# Local fallback:
DATABASE_URL=sqlite:///./retailza.db

# Aiven PostgreSQL Cloud Database:
# DATABASE_URL=postgresql://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require

# Security & JWT
SECRET_KEY=retailza_change_this_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP Configuration
OTP_EXPIRE_MINUTES=5
DEBUG_MOCK_OTP=True
MOCK_OTP_CODE=123456

# Subscription & Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here
SUBSCRIPTION_AMOUNT=49.00

# App Settings
APP_NAME=Retailza
APP_ENV=development
DEBUG=True

# Retailza Backend Environment Configuration Template

# Database:
# Local SQLite fallback:
DATABASE_URL=sqlite:///./retailza.db

# MySQL Database (Local or Cloud - AWS RDS, PlanetScale, Aiven, GCP Cloud SQL):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/retailza_db?charset=utf8mb4

# Aiven PostgreSQL Cloud Database:
# DATABASE_URL=postgresql://avnadmin:<password>@<host>:<port>/defaultdb?sslmode=require

# Security & JWT
# REQUIRED in production (app refuses to start without it). Generate a strong
# random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Allowed browser origins for CORS (comma-separated, or *). Mobile app unaffected.
ALLOWED_ORIGINS=*

# One-time super-admin seed. If email+password are blank, no admin is created,
# and an existing admin is never overwritten. Clear the password after first boot.
SEED_ADMIN_EMAIL=
SEED_ADMIN_MOBILE=
SEED_ADMIN_NAME=Retailza Super Admin
SEED_ADMIN_PASSWORD=

# OTP Configuration
OTP_EXPIRE_MINUTES=5
DEBUG_MOCK_OTP=True
MOCK_OTP_CODE=123456
# OTP abuse protection
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_WINDOW=5
OTP_MAX_VERIFY_ATTEMPTS=5

# Subscription Payments (direct UPI into your OWN account — no aggregator)
# The ₹49 is paid straight to this UPI ID. The app shows it as a QR/intent;
# the shop owner pays with any UPI app and submits the 12-digit UTR to activate.
SUBSCRIPTION_UPI_ID=techmasters@okhdfcbank
SUBSCRIPTION_UPI_PAYEE=Retailza
SUBSCRIPTION_AMOUNT=49.00
SUBSCRIPTION_PERIOD_DAYS=30
# true  -> a valid, unused UTR activates the month instantly (reconcile later)
# false -> UTRs wait in REVIEW until an admin verifies each one
SUBSCRIPTION_AUTO_ACTIVATE_ON_UTR=true
# Server-side paywall: turn on only once you are ready to collect from everyone.
ENFORCE_SUBSCRIPTION=false

# App Settings
APP_NAME=Retailza
APP_ENV=development
DEBUG=True
